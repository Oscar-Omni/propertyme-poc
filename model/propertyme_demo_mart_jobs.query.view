# Reference this view as propertyme_demo_mart_jobs
label: Synthetic Repair Jobs
description: Illustrative PropertyMe POC synthetic demonstration. No customer data. Fixed
  cutoff 2026-10-31. Repair spend is not revenue or profit.

sql: SELECT "SYNTHETIC_LABEL", "AGENCY_ID", "JOB_ID", "PROPERTY_ID",
  "INSPECTION_ID", "FINDING_ID", "SUPPLIER_ID", "CATEGORY", "PRIORITY",
  "STATUS", "CREATED_AT", "APPROVED_AT", "COMPLETED_AT",
  "ILLUSTRATIVE_TARGET_HOURS", "MANAGER_ID", "AGENCY_NAME", "SUPPLIER_NAME",
  "REPAIR_SPEND_CENTS", "BILL_COUNT", "QUOTE_COUNT", "AGE_AT_CUTOFF_HOURS",
  "COMPLETED_CYCLE_HOURS", "APPROVAL_HOURS", "MISSING_INVOICE", "REPEAT_REPAIR"
  FROM DEMO_DATABASE.DEMO_SCHEMA.PROPERTYME_DEMO_MART_JOBS

dimensions:
  synthetic_label:
    sql: '"SYNTHETIC_LABEL"'
    label: Synthetic Label

  agency_id:
    sql: '"AGENCY_ID"'
    label: Agency Id
    format: ID

  job_id:
    sql: '"JOB_ID"'
    label: Job Id
    format: ID
    primary_key: true

  property_id:
    sql: '"PROPERTY_ID"'
    label: Property Id
    format: ID

  inspection_id:
    sql: '"INSPECTION_ID"'
    label: Inspection Id
    format: ID

  finding_id:
    sql: '"FINDING_ID"'
    label: Finding Id
    format: ID

  supplier_id:
    sql: '"SUPPLIER_ID"'
    label: Supplier Id
    format: ID

  category:
    sql: '"CATEGORY"'
    label: Category

  priority:
    sql: '"PRIORITY"'
    label: Priority

  status:
    sql: '"STATUS"'
    label: Status

  created_at:
    sql: '"CREATED_AT"'
    label: Created At

  approved_at:
    sql: '"APPROVED_AT"'
    label: Approved At

  completed_at:
    sql: '"COMPLETED_AT"'
    label: Completed At

  illustrative_target_hours:
    sql: '"ILLUSTRATIVE_TARGET_HOURS"'
    label: Illustrative Target Hours

  manager_id:
    sql: '"MANAGER_ID"'
    label: Manager Id
    format: ID

  agency_name:
    sql: '"AGENCY_NAME"'
    label: Agency Name

  supplier_name:
    sql: '"SUPPLIER_NAME"'
    label: Supplier Name

  repair_spend_cents:
    sql: '"REPAIR_SPEND_CENTS"'
    label: Repair Spend Cents

  bill_count:
    sql: '"BILL_COUNT"'
    label: Bill Count

  quote_count:
    sql: '"QUOTE_COUNT"'
    label: Quote Count

  age_at_cutoff_hours:
    sql: '"AGE_AT_CUTOFF_HOURS"'
    label: Age At Cutoff Hours

  completed_cycle_hours:
    sql: '"COMPLETED_CYCLE_HOURS"'
    label: Completed Cycle Hours

  approval_hours:
    sql: '"APPROVAL_HOURS"'
    label: Approval Hours

  missing_invoice:
    sql: '"MISSING_INVOICE"'
    label: Missing Invoice

  repeat_repair:
    sql: '"REPEAT_REPAIR"'
    label: Repeat Repair

measures:
  count:
    label: Repair Jobs
    aggregate_type: count

  repair_spend_aud:
    sql: ${repair_spend_cents} / 100.0
    label: Repair Spend AUD
    format: currency_2
    aggregate_type: sum

  average_completed_cycle_hours:
    sql: ${completed_cycle_hours}
    label: Average Completed Cycle Hours
    aggregate_type: average

  average_approval_hours:
    sql: ${approval_hours}
    label: Average Approval Hours
    aggregate_type: average

  open_age_hours:
    sql: ${age_at_cutoff_hours}
    label: Average Open Age Hours
    aggregate_type: average
    filters:
      status:
        not: completed

  missing_invoices:
    sql: ${missing_invoice}
    label: Completed Jobs Missing Invoice
    aggregate_type: sum

  quote_total:
    sql: ${quote_count}
    label: Quotes
    aggregate_type: sum
