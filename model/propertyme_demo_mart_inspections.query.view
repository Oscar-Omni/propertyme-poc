# Reference this view as propertyme_demo_mart_inspections
label: Synthetic Inspections
description: Illustrative PropertyMe POC synthetic demonstration. No customer data. Fixed
  cutoff 2026-10-31. Repair spend is not revenue or profit.

sql: SELECT "SYNTHETIC_LABEL", "AGENCY_ID", "INSPECTION_ID", "PROPERTY_ID",
  "TENANCY_ID", "MANAGER_ID", "SCHEDULED_AT", "COMPLETED_AT", "INSPECTION_TYPE",
  "FINDING_COUNT", "JOB_COUNT", "REPAIR_SPEND_CENTS" FROM
  DEMO_DATABASE.DEMO_SCHEMA.PROPERTYME_DEMO_MART_INSPECTIONS

dimensions:
  synthetic_label:
    sql: '"SYNTHETIC_LABEL"'
    label: Synthetic Label

  agency_id:
    sql: '"AGENCY_ID"'
    label: Agency Id
    format: ID

  inspection_id:
    sql: '"INSPECTION_ID"'
    label: Inspection Id
    format: ID
    primary_key: true

  property_id:
    sql: '"PROPERTY_ID"'
    label: Property Id
    format: ID

  tenancy_id:
    sql: '"TENANCY_ID"'
    label: Tenancy Id
    format: ID

  manager_id:
    sql: '"MANAGER_ID"'
    label: Manager Id
    format: ID

  scheduled_at:
    sql: '"SCHEDULED_AT"'
    label: Scheduled At

  completed_at:
    sql: '"COMPLETED_AT"'
    label: Completed At

  inspection_type:
    sql: '"INSPECTION_TYPE"'
    label: Inspection Type

  finding_count:
    sql: '"FINDING_COUNT"'
    label: Finding Count

  job_count:
    sql: '"JOB_COUNT"'
    label: Job Count

  repair_spend_cents:
    sql: '"REPAIR_SPEND_CENTS"'
    label: Repair Spend Cents

measures:
  count:
    label: Inspections
    aggregate_type: count

  repair_spend_aud:
    sql: ${repair_spend_cents} / 100.0
    label: Repair Spend AUD
    format: currency_2
    aggregate_type: sum
